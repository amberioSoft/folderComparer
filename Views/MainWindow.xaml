<Window x:Class="FolderDiff.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FolderDiff.Views"
        xmlns:vm="clr-namespace:FolderDiff.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Folder Diff" Height="820" Width="1420" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CompareCommand}" />
        <KeyBinding Key="R" Modifiers="Control" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="F8" Command="{Binding NextChangeCommand}" />
        <KeyBinding Key="F7" Command="{Binding PreviousChangeCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="До (ліва)" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Padding="5,4" MinWidth="140"
                         AutomationProperties.AutomationId="LeftPathBox"
                         Text="{Binding LeftPath, UpdateSourceTrigger=PropertyChanged}"
                         AllowDrop="True" PreviewDragOver="OnPathDragOver" Drop="OnLeftDrop" />
                <Button Grid.Row="0" Grid.Column="2" Content="Огляд..." Margin="6,0,0,0" Padding="10,4"
                        AutomationProperties.AutomationId="BrowseLeftButton"
                        Command="{Binding BrowseLeftCommand}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Після (права)" Style="{StaticResource FieldLabel}"
                           Margin="0,8,8,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Padding="5,4" MinWidth="140"
                         AutomationProperties.AutomationId="RightPathBox"
                         Text="{Binding RightPath, UpdateSourceTrigger=PropertyChanged}"
                         AllowDrop="True" PreviewDragOver="OnPathDragOver" Drop="OnRightDrop" />
                <Button Grid.Row="1" Grid.Column="2" Content="Огляд..." Margin="6,8,0,0" Padding="10,4"
                        AutomationProperties.AutomationId="BrowseRightButton"
                        Command="{Binding BrowseRightCommand}" />

                <StackPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button Content="Порівняти (F5)" Style="{StaticResource ToolButton}" MinWidth="130"
                            AutomationProperties.AutomationId="CompareButton"
                            Command="{Binding CompareCommand}" />
                    <Button Content="Оновити (Ctrl+R)" Style="{StaticResource ToolButton}" MinWidth="130"
                            ToolTip="Перерахувати зміни, зберігши вибраний файл"
                            Command="{Binding RefreshCommand}" />
                    <Button Content="Скасувати" Style="{StaticResource ToolButton}"
                            Command="{Binding CancelCommand}" />
                    <Button Content="Поміняти" Style="{StaticResource ToolButton}"
                            Command="{Binding SwapCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" BorderThickness="0" Background="{StaticResource SurfaceBrush}"
                    Padding="0" Margin="0">
            <TabItem Header="Різниця" AutomationProperties.AutomationId="TabDiff">
                <views:DiffView x:Name="DiffPane" />
            </TabItem>
            <TabItem Header="Передача картинками" AutomationProperties.AutomationId="TabTransfer">
                <views:TransferView DataContext="{Binding Transfer}" />
            </TabItem>
            <TabItem Header="Ключ" AutomationProperties.AutomationId="TabKeys">
                <views:KeysView DataContext="{Binding Keys}" />
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource BorderLineBrush}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Width="200" Height="12" Margin="12,0,0,0"
                             Maximum="100" Value="{Binding ProgressValue}"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
