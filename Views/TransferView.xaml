<UserControl x:Class="FolderDiff.Views.TransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FolderDiff.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TransferViewModel}">

    <Grid Background="{StaticResource ChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="14,8" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderLineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Ключ" Style="{StaticResource RowLabel}" />
                <TextBlock Text="{Binding KeySummary}" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{Binding CanPackWithKey, Converter={StaticResource OkBrush}}" />
                <TextBlock Text="{Binding OperationTitle}" Margin="24,0,0,0" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedTextBrush}" />
                <ProgressBar Width="160" Height="10" Margin="10,0,0,0" IsIndeterminate="True"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisible}}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Відправити папку картинками" Style="{StaticResource CardTitle}" />

                    <TextBlock Style="{StaticResource Hint}"
                               Text="{Binding SourceFolder, StringFormat='Пакується права папка «Після»: {0}'}" />

                    <TextBlock Text="Що відправляти" Style="{StaticResource RowLabel}" Margin="0,4,0,4" />
                    <RadioButton GroupName="BaseMode" Content="Уся папка, повна копія" Margin="0,2"
                                 IsChecked="{Binding BaseMode, Converter={StaticResource EnumMatch}, ConverterParameter=Full}" />
                    <RadioButton GroupName="BaseMode" Content="Тільки зміни проти лівої папки «До»" Margin="0,2"
                                 IsChecked="{Binding BaseMode, Converter={StaticResource EnumMatch}, ConverterParameter=AgainstFolder}" />
                    <RadioButton GroupName="BaseMode" Content="Тільки зміни проти файлу знімка" Margin="0,2"
                                 IsChecked="{Binding BaseMode, Converter={StaticResource EnumMatch}, ConverterParameter=SnapshotFile}" />
                    <RadioButton GroupName="BaseMode" Content="Тільки зміни проти запамʼятованої версії в папці" Margin="0,2"
                                 IsChecked="{Binding BaseMode, Converter={StaticResource EnumMatch}, ConverterParameter=RememberedVersion}" />

                    <Grid Margin="20,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Padding="4,3" Text="{Binding SnapshotPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Файл знімка .icv"
                                 AutomationProperties.AutomationId="SnapshotBox"
                                 IsEnabled="{Binding BaseMode, Converter={StaticResource EnumMatch}, ConverterParameter=SnapshotFile}" />
                        <Button Grid.Column="1" Content="Огляд..." Padding="10,3" Margin="6,0,0,0"
                                IsEnabled="{Binding BaseMode, Converter={StaticResource EnumMatch}, ConverterParameter=SnapshotFile}"
                                Command="{Binding BrowseSnapshotCommand}" />
                        <Button Grid.Column="2" Content="Створити знімок..." Padding="10,3" Margin="6,0,0,0"
                                Command="{Binding CreateSnapshotCommand}" />
                    </Grid>

                    <TextBlock Text="{Binding BaseDescription}" Style="{StaticResource Hint}" Margin="0,8,0,10" />

                    <TextBlock Text="Куди покласти картинки" Style="{StaticResource RowLabel}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Padding="5,4" AutomationProperties.AutomationId="OutputFolderBox"
                                 Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Огляд..." Padding="10,4" Margin="6,0,0,0"
                                Command="{Binding BrowseOutputCommand}" />
                        <Button Grid.Column="2" Content="Відкрити" Padding="10,4" Margin="6,0,0,0"
                                Command="{Binding OpenOutputFolderCommand}" />
                    </Grid>

                    <Expander Header="Додаткові параметри" Margin="0,12,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <WrapPanel>
                                <TextBlock Text="Картинок" Style="{StaticResource RowLabel}" />
                                <ComboBox Width="80" Margin="0,0,16,6" ItemsSource="{Binding PartsOptions}"
                                          SelectedItem="{Binding Parts}"
                                          ToolTip="0 означає автоматично: повна копія завжди 5">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource AutoNumber}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Біт на канал" Style="{StaticResource RowLabel}" />
                                <ComboBox Width="70" Margin="0,0,16,6" ItemsSource="{Binding StepBitsOptions}"
                                          SelectedItem="{Binding StepBits}"
                                          ToolTip="4 або 5 дають графіку, 8 дає шум і найменший розмір" />

                                <TextBlock Text="Стиснення" Style="{StaticResource RowLabel}" />
                                <ComboBox Width="70" Margin="0,0,16,6" ItemsSource="{Binding LevelOptions}"
                                          SelectedItem="{Binding CompressionLevel}"
                                          ToolTip="Рівень Brotli, 11 найщільніший" />

                                <TextBlock Text="Чанк МіБ" Style="{StaticResource RowLabel}" />
                                <ComboBox Width="80" Margin="0,0,16,6" ItemsSource="{Binding ChunkOptions}"
                                          SelectedItem="{Binding ChunkMiB}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource AutoNumber}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Потоків" Style="{StaticResource RowLabel}" />
                                <ComboBox Width="80" Margin="0,0,16,6" ItemsSource="{Binding ThreadsOptions}"
                                          SelectedItem="{Binding Threads}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource AutoNumber}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Префікс назв" Style="{StaticResource RowLabel}" />
                                <TextBox Width="80" Padding="4,3" Margin="0,0,16,6"
                                         Text="{Binding NamePrefix, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Пріоритет процесу" Style="{StaticResource RowLabel}" />
                                <ComboBox Width="120" Margin="0,0,16,6" ItemsSource="{Binding PriorityOptions}"
                                          SelectedItem="{Binding Priority}"
                                          ToolTip="Порожнє значення не змінює пріоритет. Нижчий пріоритет уповільнить і саме вікно.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </WrapPanel>

                            <WrapPanel Margin="0,4,0,0">
                                <CheckBox Content="Лишити архів на диску" Margin="0,0,16,6"
                                          IsChecked="{Binding KeepArchive}" />
                                <CheckBox Content="Запамʼятати версію в папці" Margin="0,0,16,6"
                                          ToolTip="Дозволяє потім пакувати проти запамʼятованої версії"
                                          IsChecked="{Binding RememberVersion}" />
                            </WrapPanel>

                            <TextBlock Text="Готові набори виключень" Style="{StaticResource RowLabel}" Margin="0,8,0,4" />
                            <ItemsControl ItemsSource="{Binding Presets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" Margin="0,0,14,4"
                                                  IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Додатково виключити" Style="{StaticResource RowLabel}" Margin="0,8,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Padding="4,3" ToolTip="Шаблони через ; наприклад *.pdf;installer/"
                                         Text="{Binding ExtraExcludes, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Content="З файлу..." Padding="10,3" Margin="6,0,0,0"
                                        Command="{Binding LoadExcludeFileCommand}" />
                            </Grid>
                            <TextBlock Text="{Binding EffectiveExcludesText}" Style="{StaticResource Hint}" />

                            <TextBlock Text="Ховати дані у власні фото PNG" Style="{StaticResource RowLabel}"
                                       Margin="0,8,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ListBox MaxHeight="90" ItemsSource="{Binding CoverFiles}" FontSize="11" />
                                <Button Grid.Column="1" Content="Додати..." Padding="10,3" Margin="6,0,0,0"
                                        VerticalAlignment="Top" Command="{Binding AddCoverCommand}" />
                                <Button Grid.Column="2" Content="Очистити" Padding="10,3" Margin="6,0,0,0"
                                        VerticalAlignment="Top" Command="{Binding ClearCoversCommand}" />
                                <ComboBox Grid.Column="3" Width="60" Margin="6,0,0,0" VerticalAlignment="Top"
                                          ItemsSource="{Binding CoverBitsOptions}" SelectedItem="{Binding CoverBits}"
                                          ToolTip="Біт на канал у фото" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Фото лишається на вигляд таким самим. Для повної копії проєкту цей режим не годиться, потрібні десятки мегабайтів." />
                        </StackPanel>
                    </Expander>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Оцінити різницю" Padding="12,6" MinWidth="140"
                                ToolTip="Порахувати, скільки реально поїде, нічого не записуючи"
                                Command="{Binding EstimateCommand}" />
                        <Button Content="Пробний прогін" Padding="12,6" MinWidth="130" Margin="8,0,0,0"
                                ToolTip="Показати, що буде запаковано, без запису картинок"
                                Command="{Binding DryRunCommand}" />
                        <Button Content="Запакувати" Padding="12,6" MinWidth="130" Margin="8,0,0,0"
                                FontWeight="SemiBold" Command="{Binding PackCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorder}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Отримати папку з картинок" Style="{StaticResource CardTitle}" />

                    <TextBlock Text="Папка з картинками" Style="{StaticResource RowLabel}" />
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Padding="5,4" AutomationProperties.AutomationId="ImagesFolderBox"
                                 Text="{Binding ImagesFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Огляд..." Padding="10,4" Margin="6,0,0,0"
                                Command="{Binding BrowseImagesCommand}" />
                        <Button Grid.Column="2" Content="= вихідна" Padding="10,4" Margin="6,0,0,0"
                                ToolTip="Узяти папку, в яку пакували"
                                Command="{Binding UseOutputAsImagesCommand}" />
                    </Grid>

                    <TextBlock Text="Куди відновити" Style="{StaticResource RowLabel}" />
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Padding="5,4" AutomationProperties.AutomationId="RestoreFolderBox"
                                 Text="{Binding RestoreFolder, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Content="Огляд..." Padding="10,4" Margin="6,0,0,0"
                                Command="{Binding BrowseRestoreCommand}" />
                        <Button Grid.Column="2" Content="= Після" Padding="10,4" Margin="6,0,0,0"
                                ToolTip="Узяти праву папку з порівняння"
                                Command="{Binding UseRightAsRestoreCommand}" />
                    </Grid>

                    <CheckBox Content="Не перевіряти підпис відправника" Margin="0,2"
                              IsChecked="{Binding SkipSignature}" />
                    <CheckBox Content="Запамʼятати версію в папці після розпакування" Margin="0,4"
                              IsChecked="{Binding RememberAfterUnpack}" />

                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Програма сама бачить, повна це копія чи набір змін. Для набору змін вона спершу звіряє контрольну суму папки і відмовиться, якщо це не та база." />

                    <Button Content="Розпакувати" Padding="12,6" MinWidth="130" Margin="0,10,0,0"
                            HorizontalAlignment="Left" FontWeight="SemiBold"
                            Command="{Binding UnpackCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Результат" Style="{StaticResource CardTitle}" />

                        <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{StaticResource StatusDeletedBrush}"
                                   Visibility="{Binding ErrorText, Converter={StaticResource TextToVisible}}" />

                        <StackPanel Visibility="{Binding DeltaEstimate, Converter={StaticResource NotNullToVisible}}"
                                    Margin="0,0,0,10">
                            <TextBlock Text="Різниця" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding DeltaEstimate.FilesText}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding DeltaEstimate.RemovedText}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding DeltaEstimate.LiteralBytesText, StringFormat='нових даних {0}'}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding DeltaEstimate.CopiedBytesText, StringFormat='перевикористано з бази {0}'}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding DeltaEstimate.NewTotalBytesText, StringFormat='розмір нової версії {0}'}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding PackReport, Converter={StaticResource NotNullToVisible}}">
                            <TextBlock Text="Упаковка" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding PackReport.ModeText, StringFormat='режим: {0}'}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding PackReport.ContentText}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding PackReport.OriginalBytesText, StringFormat='оригінал {0}'}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding PackReport.ArchiveBytesText, StringFormat='після стиснення {0}'}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding PackReport.CipherBytesText, StringFormat='після шифрування {0}'}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding PackReport.ImageBytesText, StringFormat='картинки разом {0}'}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding PackReport.ReplacedImages, StringFormat='перезаписано старих картинок: {0}'}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding PackReport.TreeDigest, StringFormat='відпечаток дерева {0}'}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding PackReport.ElapsedText, StringFormat='час {0}'}" />

                            <ItemsControl ItemsSource="{Binding PackReport.Images}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Resolution}" FontSize="11"
                                                       Margin="8,0" Foreground="{StaticResource MutedTextBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding FileLengthText}" FontSize="11"
                                                       Foreground="{StaticResource MutedTextBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Visibility="{Binding UnpackReport, Converter={StaticResource NotNullToVisible}}">
                            <TextBlock Text="Розпакування" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding UnpackReport.ModeText}" />
                            <TextBlock Style="{StaticResource Hint}" Text="{Binding UnpackReport.ContentText}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding UnpackReport.OriginalBytesText, StringFormat='розмір {0}'}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{Binding UnpackReport.ElapsedText, StringFormat='час {0}'}" />

                            <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                <TextBlock Text="{Binding UnpackReport.SummaryMatches, Converter={StaticResource CheckMark}}"
                                           FontWeight="Bold" Margin="0,0,6,0"
                                           Foreground="{Binding UnpackReport.SummaryMatches, Converter={StaticResource OkBrush}}" />
                                <TextBlock Text="розміри і контрольні суми збіглися з відправником" FontSize="11.5" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <TextBlock Text="{Binding UnpackReport.ImageSummaryMatches, Converter={StaticResource CheckMark}}"
                                           FontWeight="Bold" Margin="0,0,6,0"
                                           Foreground="{Binding UnpackReport.ImageSummaryMatches, Converter={StaticResource OkBrush}}" />
                                <TextBlock Text="зводка в картинці збіглася з даними" FontSize="11.5" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding UnpackReport.SignatureVerified, Converter={StaticResource CheckMark}}"
                                           FontWeight="Bold" Margin="0,0,6,0"
                                           Foreground="{Binding UnpackReport.SignatureVerified, Converter={StaticResource OkBrush}}" />
                                <TextBlock Text="підпис відправника дійсний" FontSize="11.5" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                          Background="{StaticResource ChromeBrush}" />

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0,6,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Журнал" Style="{StaticResource CardTitle}" Margin="0" />
                        <Button Grid.Column="1" Content="Копіювати" Padding="8,3" Margin="6,0,0,0"
                                Command="{Binding CopyLogCommand}" />
                        <Button Grid.Column="2" Content="Очистити" Padding="8,3" Margin="6,0,0,0"
                                Command="{Binding ClearLogCommand}" />
                    </Grid>
                    <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding Log}"
                             FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
